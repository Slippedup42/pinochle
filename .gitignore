# Netlify CLI scratch state, written on every `netlify deploy`. Local
# artifact only — the committed config is the root `netlify.toml`.
.netlify/

# Scratch git worktrees created for background agents, one per task. They
# hold real checkouts of this repo, so leaving them untracked made every
# build stamp report `dirty: true` (#237) while an agent was running —
# which is exactly the false signal that stamp exists to avoid.
.claude/worktrees/
